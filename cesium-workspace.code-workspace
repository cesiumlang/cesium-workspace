{
  "folders": [
    {
      "path": "."
    },
    {
      "path": "../../scratch/git/skein"
    }
  ],
  // This repository is the parent of the Cesium repositories, which are its
  // submodules. The settings of their workspace files are repeated here, with
  // their paths, so that opening this one workspace is enough:
  //   cesium-src/cesium.code-workspace
  //   cesium-src/buildtools/cesium-buildtools.code-workspace
  //   cesiumlang.org/cesiumlang.org.code-workspace
  //   cesiumlang.org/grammar/grammar.code-workspace
  //   devkits/devkits.code-workspace
  //   vscode-cesium/vscode-cesium.code-workspace
  // A setting added to one of those belongs here too.
  "settings": {
    // breakpoints in .csm files without vscode-cesium 0.1.3 installed, which
    // allows them (cesiumlang/vscode-cesium#48); remove once it is
    "debug.allowBreakpointsEverywhere": true,
    "files.associations": {
      // Cesium source and module interface files (cesiumlang/cesium#14)
      "*.csm": "cesium",
      "*.csi": "cesium",
      "VERSION": "plaintext",
      ".local-gitignore": "gitignore",
      ".github/workflows/exempt.txt": "gitignore",
      ".clangd": "yaml",
      "**/.claude/projects/*/memory/*.md": "plaintext",
      // devkits
      "no-ci.txt": "gitignore",
      "*.ssa": "plaintext",
      // skein: Jekyll templates are Liquid, which HTML checkers cannot parse
      "**/site/_layouts/*.html": "liquid",
      "**/site/_includes/*.html": "liquid",
    },
    "files.exclude": {
      "**/node_modules/**": true,
      "**/.zig-cache/**": true,
      "**/zig-pkg/**": true,
      "**/zig-cache*/**": true,
      "**/.cache/**": true,
      "cesium-src/.devkit-downloads/**": true,
      "cesiumlang.org/zig-out/**": true,
      // LLVM is built from, never edited: keep it out of the explorer
      "devkits/llvm-project": true,
      "devkits/work/**": true,
      "devkits/dist/**": true,
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.zig-cache/**": true,
      "**/zig-pkg/**": true,
      "**/zig-cache*/**": true,
      "**/.cache/**": true,
      "**/.git/**": true,
      "cesium-src/zig-out/**": true,
      "cesium-src/tmp/**": true,
      "cesium-src/.devkit/**": true,
      "cesium-src/.devkit-downloads/**": true,
      "cesium-src/buildtools/bin/**": true,
      "cesium-src/buildtools/downloads/**": true,
      "cesium-src/buildtools/opt/**": true,
      "cesiumlang.org/zig-out/**": true,
      "cesiumlang.org/cesium-src/**": true,
      "devkits/llvm-project/**": true,
      "devkits/work/**": true,
      "devkits/dist/**": true,
      "vscode-cesium/dist/**": true,
      "vscode-cesium/out/**": true,
      "vscode-cesium/.vscode-test/**": true,
    },
    "search.exclude": {
      "cesium-src/.devkit/**": true,
      "cesium-src/buildtools/opt/**": true,
      "cesiumlang.org/zig-out/**": true,
      "cesiumlang.org/cesium-src/**": true,
      "devkits/llvm-project/**": true,
      "devkits/qbe/**": true,
    },
    "files.insertFinalNewline": true,
    "editor.wrappingIndent": "indent",
    "[markdown]": {
      "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
      }
    },
    "editor.semanticTokenColorCustomizations": {
      "rules": {
        "*.deprecated": {
          // highlight semantic tokens that are marked as "deprecated"
          "strikethrough": true
        },
      },
    },
    "terminal.integrated.automationProfile.windows": {
      "path": "C:\\windows\\system32\\cmd.exe",
    },
    "ltex.additionalRules.motherTongue": "en-US",
    "debug.onTaskErrors": "abort",  // will switch to problems pane otherwise

    // LLVM is a repository of its own inside devkits; the Git extension
    // need not open it
    "git.repositoryScanIgnoredFolders": [
      "node_modules",
      "llvm-project",
    ],
    // and Pylance need not index its thousands of Python files. Setting this
    // replaces Pylance's defaults, which are the first three entries.
    "python.analysis.exclude": [
      "**/node_modules",
      "**/__pycache__",
      "**/.*",
      "devkits/llvm-project",
      "devkits/work",
      "devkits/dist",
      "cesiumlang.org/zig-out",
    ],

    // cesiumlang.org
    "foam.openDailyNote.onStartup": false,
    "foam.edit.linkReferenceDefinitions": "off",
    "foam.files.exclude": [
      "**/readme.md",
      "cesium-src/**/*",
      "devkits/**/*",
      "dot-github/**/*",
      "vscode-cesium/**/*",
      "cesiumlang.org/zig-out/**/*",
      "cesiumlang.org/site/content/**/*",
      "cesiumlang.org/grammar/**/*",
    ],
    "foam.files.newNotePath": "currentDir",
    "foam.completion.useAlias": "whenPathDiffersFromTitle",
    "foam.preview.embedNoteType": "content-inline",
    "svg.preview.background": "dark-transparent",

    // cesium-src: the Zig of the Cesium devkit
    // (cd cesium-src && bash tools/fetch-devkit.sh)
    "zig.path": "${workspaceFolder}/cesium-src/.devkit/zig/zig",
    "zig.zls.enabled": "on",
    "zig.zls.inlayHintsShowParameterName": false,
    "zig.zls.inlayHintsExcludeSingleArgument": false,
    "zig.zls.inlayHintsShowBuiltin": false,
    "zig.zls.inlayHintsShowStructLiteralFieldType": false,
    "zig.zls.inlayHintsShowVariableTypeHints": false,
    "zig.zls.warnStyle": true,
    "zig.zls.enableArgumentPlaceholders": false,

    // cesium-src: clangd is the language server for the C that `zig cc`
    // compiles. The clangd extension offers to download clangd when none is
    // on PATH. The Microsoft C/C++ extension stays for debugging only.
    "C_Cpp.intelliSenseEngine": "disabled",

    // no CMake project here; C dependencies may carry a CMakeLists.txt
    "cmake.ignoreCMakeListsMissing": true,
    "cmake.configureOnOpen": false,
  },
  "extensions": {
    // See http://go.microsoft.com/fwlink/?LinkId=827846
    // for the documentation about the extensions.json format
    "recommendations": [
      "yzhang.markdown-all-in-one",
      "bierner.markdown-yaml-preamble",
      "davidanson.vscode-markdownlint",
      "streetsidesoftware.code-spell-checker",
      "streetsidesoftware.code-spell-checker-scientific-terms",
      "streetsidesoftware.code-spell-checker-win32",
      "ltex-plus.vscode-ltex-plus",

      // cesiumlang.org
      "foam.foam-vscode",

      // cesium-src
      "ziglang.vscode-zig",
      "llvm-vs-code-extensions.vscode-clangd",
      "ms-vscode.cpptools",  // windows debug
      // "vadimcn.vscode-lldb",  // posix debug

      // devkits
      "timonwong.shellcheck",

      // skein
      "sissel.shopify-liquid",
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "cesium-src: zig build",
        "type": "shell",
        "command": "${config:zig.path}",
        "args": [
          "build",
        ],
        "options": {
          "cwd": "${workspaceFolder}/cesium-src"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [],
        "presentation": {
          "clear": true,
          "reveal": "always",
          "panel": "shared",
          "focus": true,
          "revealProblems": "never",
        },
      },
      {
        "label": "cesium-src: zig build test",
        "type": "shell",
        "command": "${config:zig.path}",
        "args": [
          "build",
          "test",
          "--summary",
          "all",
        ],
        "options": {
          "cwd": "${workspaceFolder}/cesium-src"
        },
        "group": "test",
        "problemMatcher": [],
        "presentation": {
          "clear": true,
          "reveal": "always",
          "panel": "shared",
          "focus": true,
          "revealProblems": "never",
        },
      },
      {
        "label": "cesium-src: zig build lines",
        "type": "shell",
        "command": "${config:zig.path}",
        "args": [
          "build",
          "lines",
        ],
        "options": {
          "cwd": "${workspaceFolder}/cesium-src"
        },
        "problemMatcher": [],
        "presentation": {
          "clear": true,
          "reveal": "always",
          "panel": "shared",
          "revealProblems": "never",
        },
      },
      {
        "label": "site: build and serve",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "dev",
        ],
        "options": {
          "cwd": "${workspaceFolder}/cesiumlang.org"
        },
        "problemMatcher": [],
        "presentation": {
          "clear": true,
          "reveal": "always",
          "panel": "dedicated",
        },
      },
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "cesium-src: cesium0 (cppvsdbg)",
        "type": "cppvsdbg",
        "request": "launch",
        "program": "${workspaceFolder}/cesium-src/zig-out/bin/cesium0.exe",
        "args": [
          "--emit-mir",
          "-o",
          "${workspaceFolder}/cesium-src/tmp/out.mir",
          "${workspaceFolder}/cesium-src/bootstrap/tests/s0/tokens.csm",
        ],
        "cwd": "${workspaceFolder}/cesium-src",
        "preLaunchTask": "cesium-src: zig build",
        "console": "integratedTerminal",
      },
      // Cesium code by .csm line: breakpoints in bootstrap/stage1/*.csm
      // (CodeView, cesiumlang/vscode-cesium#47)
      {
        "name": "cesium-src: cesium1 (cppvsdbg)",
        "type": "cppvsdbg",
        "request": "launch",
        "program": "${workspaceFolder}/cesium-src/zig-out/bin/cesium1.exe",
        "args": [
          "-o",
          "${workspaceFolder}/cesium-src/tmp/out1.s",
          "${workspaceFolder}/cesium-src/bootstrap/tests/s0/tokens.csm",
        ],
        "cwd": "${workspaceFolder}/cesium-src",
        "preLaunchTask": "cesium-src: zig build",
        "console": "integratedTerminal",
      },
      // bootstrap/tests/s0/lines.csm, which traps at line 12
      {
        "name": "cesium-src: lines (cppvsdbg)",
        "type": "cppvsdbg",
        "request": "launch",
        "program": "${workspaceFolder}/cesium-src/zig-out/bin/lines.exe",
        "cwd": "${workspaceFolder}/cesium-src",
        "preLaunchTask": "cesium-src: zig build lines",
        "console": "integratedTerminal",
      },
    ],
    "compounds": []
  },
}
