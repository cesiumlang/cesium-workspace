#!/usr/bin/env bash
# direnv: the tools of the submodules, each from its own .envrc. Git Bash
# (cesium-src/buildtools/direnv-hook.sh in ~/.bashrc), VS Code (the direnv
# extension) and Claude Code (.claude/hooks/direnv-env.sh) all load this file.

# cesium-src: the Cesium devkit (Zig, QBE), the compiler's build outputs, and
# through cesium-src/buildtools/.envrc the tools of buildtools (the Vulkan
# SDK, tree-sitter, Node.js, direnv)
source_env_if_exists cesium-src/.envrc

# cesiumlang.org: Node.js for the site, the version in its .node-version,
# through fnm; only where buildtools has no Node.js, which comes first.
# vscode-cesium asks for the same version.
if [ -z "$(compgen -G 'cesium-src/buildtools/opt/node-*')" ]; then
  source_env_if_exists cesiumlang.org/.envrc
fi

# vscode-cesium: zcsls, the temporary language server, as `zig build` there
# writes it; the agent plugin (vscode-cesium/agent-plugin, installed for this
# workspace in .claude/settings.json) starts it from the PATH
PATH_add vscode-cesium/zig-out/bin
