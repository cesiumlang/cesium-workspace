#!/usr/bin/env bash
# direnv: the tools of the submodules, each from its own .envrc.

# cesium-src: the Cesium devkit (Zig, QBE) and the compiler's build outputs
source_env_if_exists cesium-src/.envrc

# cesiumlang.org: Node.js for the site, the version in its .node-version,
# through fnm. vscode-cesium asks for the same version.
source_env_if_exists cesiumlang.org/.envrc

# vscode-cesium: zcsls, the temporary language server, as `zig build` there
# writes it; the agent plugin (vscode-cesium/agent-plugin, installed for this
# workspace in .claude/settings.json) starts it from the PATH
PATH_add vscode-cesium/zig-out/bin
