{
  "extraKnownMarketplaces": {
    "cesiumlang": {
      "source": {
        "source": "directory",
        "path": "./vscode-cesium"
      }
    }
  },
  "enabledPlugins": {
    "cesium@cesiumlang": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/direnv-env.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
